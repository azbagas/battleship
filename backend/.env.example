# Server Port (default: 8080)
PORT=8080

# Logging Level: DEBUG | INFO | WARN | ERROR (default: INFO)
LOG_LEVEL=INFO

# Logging Format: text | json (default: text)
LOG_FORMAT=text

# SQLite database file path (default: battleship.db)
DB_PATH=battleship.db

# WebSocket allowed origin check (default: * wildcard in development, comma-separated list of host patterns in production)
# Example: ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://battleship.example.com
ALLOWED_ORIGINS=

# Max inbound message payload size in bytes (default: 32768 = 32 KB)
MAX_PAYLOAD_BYTES=32768

# Max concurrent WebSocket connections per client IP (default: 10)
MAX_CONNS_PER_IP=10

# Per-connection inbound message rate limit (default: 10.0 messages/second)
RATE_LIMIT_MESSAGES_PER_SEC=10.0

# Per-connection inbound message token bucket burst capacity (default: 20.0)
RATE_LIMIT_BURST=20.0


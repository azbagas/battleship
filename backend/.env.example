# Server Port (default: 8080)
PORT=8080

# Logging Level: DEBUG | INFO | WARN | ERROR (default: INFO)
LOG_LEVEL=INFO

# Logging Format: text | json (default: text)
LOG_FORMAT=text

# ------------------------------------------------------------------------------
# Planned / Upcoming Variables (will be activated in subsequent tasks)
# ------------------------------------------------------------------------------
# SQLite database file path (default: battleship.db)
DB_PATH=battleship.db

# WebSocket allowed origin check (Task T-19, default: * in development)
# ALLOWED_ORIGIN=http://localhost:3000

# Global concurrent room cap (Task T-19, default: 10)
# MAX_ROOMS=10

# Reconnection grace period in seconds (Task T-19, default: 60)
# DISCONNECT_GRACE_SECONDS=60

